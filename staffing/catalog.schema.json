{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-machinery:schema:staffing-catalog:v2",
  "title": "Agent-run template catalog",
  "description": "Structural shape only. Use the catalog-advertised validateContract export for normative structural and semantic validation.",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "version", "vocabulary", "defaults", "presets"],
  "properties": {
    "$schema": { "const": "urn:agent-machinery:schema:staffing-catalog:v2" },
    "version": { "const": 2 },
    "vocabulary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["taskGrades", "semanticTiers", "deliberations", "topologies", "postures", "capabilities"],
      "properties": {
        "taskGrades": { "$ref": "#/$defs/uniqueStrings" },
        "semanticTiers": { "$ref": "#/$defs/uniqueStrings" },
        "deliberations": { "$ref": "#/$defs/uniqueStrings" },
        "topologies": { "$ref": "#/$defs/uniqueStrings" },
        "postures": { "$ref": "#/$defs/uniqueStrings" },
        "capabilities": { "$ref": "#/$defs/uniqueStrings" }
      }
    },
    "defaults": {
      "type": "object", "additionalProperties": false,
      "required": ["taskGrade", "tier", "deliberation", "topology", "posture"],
      "properties": {
        "taskGrade": { "type": "string" }, "tier": { "type": "string" }, "deliberation": { "type": "string" },
        "topology": { "enum": ["worker", "orchestrator"], "description": "Coordination jurisdiction, not global tree depth." }, "posture": { "type": "string" }
      }
    },
    "presets": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/preset" } }
  },
  "$defs": {
    "uniqueStrings": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "capabilities": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": { "enum": ["filesystem.read", "filesystem.search", "filesystem.write", "shell", "shell.readonly", "web", "coordination"] }
    },
    "preset": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "taskGrade", "tier", "deliberation", "topology", "posture", "capabilities", "tagline", "description"],
      "properties": {
        "name": { "$ref": "#/$defs/roleId" }, "taskGrade": { "type": "string" }, "tier": { "type": "string" },
        "deliberation": { "type": "string" }, "topology": { "enum": ["worker", "orchestrator"], "description": "Worker is terminal; orchestrator may delegate only through freshly admitted child runs." }, "posture": { "type": "string" },
        "capabilities": { "$ref": "#/$defs/capabilities" }, "tagline": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 }
      }
    },
    "roleId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    }
  }
}
